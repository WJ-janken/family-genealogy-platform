.detail-page {
  min-height: 100vh;
  background: #FDF8F0;
  padding-bottom: 120rpx;
}

.header-section {
  position: relative;
  padding: 80rpx 30rpx 40rpx;
  text-align: center;
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #8B4513, #A0522D);
  border-radius: 0 0 40rpx 40rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}

.avatar { width: 100%; height: 100%; }

.avatar-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #D4A574, #8B4513);
  display: flex; align-items: center; justify-content: center;
  color: #FFF; font-size: 60rpx; font-weight: 600;
}

.member-name {
  position: relative;
  font-size: 40rpx; font-weight: 600; color: #2C2C2C;
}

.member-alias {
  font-size: 28rpx;
  color: #888;
  margin-top: 8rpx;
}

.member-tags {
  position: relative;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(139,69,19,0.1);
  color: #8B4513;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin: 0 8rpx;
}

.card {
  margin: 24rpx 30rpx;
  background: #FFF;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx; font-weight: 600; color: #2C2C2C;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-row {
  display: flex; justify-content: space-between;
  padding: 16rpx 0;
}

.info-label { color: #999; font-size: 26rpx; }
.info-value { color: #2C2C2C; font-size: 26rpx; }
.info-value.link { color: #8B4513; }

.biography { font-size: 26rpx; color: #333; line-height: 1.8; }

.career-timeline { padding-left: 20rpx; }

.career-item {
  position: relative;
  padding-left: 30rpx; padding-bottom: 24rpx;
  border-left: 2rpx solid #D4A574;
}

.career-dot {
  position: absolute; left: -8rpx; top: 8rpx;
  width: 14rpx; height: 14rpx;
  border-radius: 50%; background: #8B4513;
}

.career-position { font-size: 28rpx; font-weight: 500; color: #2C2C2C; }
.career-org { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.career-period { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.relation-item {
  display: flex; justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.relation-label { color: #999; font-size: 26rpx; }
.relation-name { color: #8B4513; font-size: 26rpx; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 30rpx;
  background: #FFF;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-edit {
  background: linear-gradient(135deg, #8B4513, #A0522D);
  color: #FFF; border-radius: 12rpx;
  font-size: 30rpx; padding: 24rpx;
  border: none;
}

.loading-state {
  display: flex; align-items: center; justify-content: center;
  min-height: 100vh; color: #999;
}
