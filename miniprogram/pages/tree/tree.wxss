.tree-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  background: #1A1A2E;
  overflow: hidden;
}

/* 工具栏 */
.toolbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  background: rgba(26, 26, 46, 0.95);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
  z-index: 100;
}

.toolbar-left {
  display: flex;
  align-items: center;
}

.btn-back {
  padding: 16rpx;
}

.icon-back {
  color: #FFFFFF;
  font-size: 36rpx;
}

.toolbar-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  margin-left: 16rpx;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.toolbar-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 32rpx;
}

/* Canvas */
.tree-canvas {
  position: absolute;
  top: 0;
  left: 0;
}

/* 浮动按钮 */
.float-buttons {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 99;
}

.float-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(139, 69, 19, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.15s ease;
}

.float-btn:active {
  transform: scale(0.9);
}

/* 底部信息条 */
.info-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(26, 26, 46, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 98;
}

.info-text {
  color: rgba(212, 165, 116, 0.8);
  font-size: 22rpx;
}

/* 加载状态 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 46, 0.9);
  z-index: 200;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(212, 165, 116, 0.3);
  border-top-color: #D4A574;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #D4A574;
  font-size: 28rpx;
  margin-top: 24rpx;
}

/* ==================== 节点详情弹窗 ==================== */
.detail-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.detail-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.detail-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.detail-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  animation: slideUp 0.3s ease forwards;
}

@keyframes slideUp {
  to { transform: translateY(0); }
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.detail-avatar.male {
  background: linear-gradient(135deg, #2196F3, #1976D2);
}

.detail-avatar.female {
  background: linear-gradient(135deg, #E91E63, #C2185B);
}

.detail-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
}

.detail-info {
  flex: 1;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 8rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #FDF8F0;
  color: #8B4513;
}

.gender-tag {
  background: #E3F2FD;
  color: #1976D2;
}

.detail-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

.detail-body {
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.row-label {
  font-size: 26rpx;
  color: #999;
  width: 100rpx;
}

.row-value {
  font-size: 28rpx;
  color: #2C2C2C;
}

.detail-footer {
  padding-top: 24rpx;
}

.btn-view-detail {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #8B4513, #A0522D);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-view-detail:active {
  opacity: 0.85;
}

/* ==================== 搜索弹窗 ==================== */
.search-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.search-popup.show {
  opacity: 1;
  pointer-events: auto;
}

.search-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.search-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding-top: env(safe-area-inset-top);
  border-radius: 0 0 24rpx 24rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: slideDown 0.3s ease forwards;
}

@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  padding: 16rpx 24rpx;
  background: #8B4513;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.search-close {
  padding: 16rpx;
  color: #666;
  font-size: 28rpx;
}

.search-results {
  flex: 1;
  max-height: 50vh;
  padding: 0 24rpx 24rpx;
}

.search-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.item-name {
  font-size: 30rpx;
  color: #2C2C2C;
  font-weight: 500;
  margin-right: 16rpx;
}

.item-info {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

.item-locate {
  font-size: 24rpx;
  color: #8B4513;
  padding: 8rpx 20rpx;
  border: 1rpx solid #8B4513;
  border-radius: 20rpx;
}

.search-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
