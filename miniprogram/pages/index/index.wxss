.page-index {
  min-height: 100vh;
  background: #FDF8F0;
}

/* 顶部 */
.header {
  position: relative;
  padding: 60rpx 30rpx 80rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #8B4513 0%, #A0522D 50%, #D4A574 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.family-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.hall-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

.message-icon {
  position: absolute;
  top: 60rpx;
  right: 30rpx;
  z-index: 2;
}

.icon-bell {
  width: 44rpx;
  height: 44rpx;
}

/* 统计卡片 */
.stats-section {
  padding: 0 30rpx;
  margin-top: -50rpx;
  position: relative;
  z-index: 2;
}

.stats-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 8rpx 32rpx rgba(139, 69, 19, 0.12);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #8B4513;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E8E8E8;
}

/* 快捷功能 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 40rpx 30rpx;
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.tree-icon {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.search-icon {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
}

.chronicle-icon {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
}

.submit-icon {
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
}

.action-text {
  font-size: 24rpx;
  color: #2C2C2C;
}

/* 最近更新 */
.recent-section {
  padding: 0 30rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 24rpx;
}

.timeline {
  padding-left: 20rpx;
}

.timeline-item {
  position: relative;
  padding-left: 30rpx;
  padding-bottom: 30rpx;
  border-left: 2rpx solid #D4A574;
}

.timeline-item:last-child {
  border-left-color: transparent;
}

.timeline-dot {
  position: absolute;
  left: -8rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #8B4513;
}

.timeline-content {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.timeline-text {
  font-size: 26rpx;
  color: #2C2C2C;
}

.timeline-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
